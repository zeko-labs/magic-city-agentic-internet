# Required keys deliberately blank: startup rejects incomplete configuration.
DEPLOYMENT_PROFILE=production
NODE_ENV=production
HOST=0.0.0.0
PORT=4411
MAGIC_CITY_CANONICAL_ORIGIN=https://agents.your-domain.example
# Exact additional Host values, including ports, if required by internal health checks.
MAGIC_CITY_ALLOWED_HOSTS=
# CIDRs for actual proxy peers only. Never 0.0.0.0/0 or ::/0.
MAGIC_CITY_TRUSTED_PROXY_CIDRS=
DATABASE_URL=
DATABASE_SSL=auto
MAGIC_CITY_REQUIRE_PRODUCTION_PERSISTENCE=true
MAGIC_CITY_REQUIRE_STATE_ENCRYPTION=true
MAGIC_CITY_REQUIRE_ARTIFACT_ENCRYPTION=true
MAGIC_CITY_POSTGRES_SINGLE_WRITER=true
MAGIC_CITY_STATE_ENCRYPTION_KEY=
MAGIC_CITY_RATE_LIMIT_STORE=postgres
MAGIC_CITY_RATE_LIMIT_SCHEMA_MANAGED=false
ADMIN_TOKEN=
# Optional receipt-import and outbound signing-relayer credentials. Leave unset
# when unused; configured values must be strong and independent of other roles.
RELAYER_TOKEN=
ZEKO_RELAYER_TOKEN=
# Exact IDs of existing operator-verified accounts, never unverified email addresses.
AUTH_ADMIN_USER_IDS=
# Email/requester allowlists do not grant administration, in any profile.
# Optional hosted service plugin (paired extensions do not need these).
# Use an independent random key, never a PUBLIC_API_KEYS or admin key.
MAGIC_CITY_PLUGIN_API_KEY=
MAGIC_CITY_PLUGIN_ALLOWED_IDS=
MAGIC_CITY_PLUGIN_OWNER_AGENT_IDS={}
PUBLIC_API_KEYS=
PRIVACY_SALT=
MISSION_BOUND_AUTH_SECRET=
MISSION_BOUND_AUTH_ED25519_PRIVATE_KEY=
MISSION_BOUND_AUTH_PUBLIC_KEY_ID=partner-mission-v1
MCP_OAUTH_SECRET=
# Optional bounded migration; omit all four unless using the reviewed runbook.
# MISSION_BOUND_AUTH_LEGACY_SECRET=
# MISSION_BOUND_AUTH_LEGACY_TOKEN_SHA256=
# MISSION_BOUND_AUTH_LEGACY_CUTOVER_AT=
# MISSION_BOUND_AUTH_LEGACY_ACCEPT_UNTIL=
# See docs/mission-key-separation-migration.md before enabling.
# Required separately if the respective OAuth connector is enabled.
GOOGLE_CONNECTOR_SECRET=
GITHUB_CONNECTOR_SECRET=
ALLOW_INSECURE_ADMIN=false
AUTH_PASSWORD_RESET_DEV_LINKS=false
AUTO_TOPUP_LOCAL_FREE=false
MAGIC_CITY_ALLOW_LOCAL_IP_ADMIN=false
MAGIC_CITY_ALLOW_STATE_RESET_ON_READ_ERROR=false
MAGIC_CITY_SANTACLAWZ_MODE=disabled
MAGIC_CITY_FINAL_SUBMIT_CHAIN_GATE_ENABLED=false
MAGIC_CITY_MISSION_AUTH_ANCHOR_ENABLED=false
MAGIC_CITY_AMAZON_SELECTION_INTELLIGENCE_ENABLED=false
AUTO_START_LOCAL_EXECUTION_AGENTS=false
AUTO_PREPARE_EXECUTION_PROOFS=false
AUTO_DRAIN_SPONSORED_PROOF_QUEUE=false
AUTO_RECOVER_SPONSORED_PROOF_QUEUE=false
ETHEREUM_SHADOW_RELAYER_ENABLED=false
ETHEREUM_SHADOW_RELAYER_LIVE_EXECUTION=false
ETHEREUM_CONFIRMATION_INDEXER_ENABLED=false
ETHEREUM_CONFIRMATION_INDEXER_AUTO_CONFIRM=false
