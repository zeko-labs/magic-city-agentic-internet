{
  "manifest_version": 3,
  "name": "Magic City Runner",
  "version": "0.5.17",
  "description": "Runs bounded Magic City browser tasks in your Chrome profile, pausing only for login, verification, or policy mismatches.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["alarms", "storage", "tabs", "scripting"],
  "host_permissions": [
    "https://magic-city.ai/*",
    "https://magic-city-staging.fly.dev/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "externally_connectable": {
    "matches": [
      "https://magic-city.ai/*",
      "https://magic-city-staging.fly.dev/*"
    ]
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Magic City Runner",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
